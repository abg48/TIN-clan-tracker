{
  "family": "tin-bot",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "__EXECUTION_ROLE_ARN__",
  "containerDefinitions": [
    {
      "name": "tin-bot",
      "image": "__IMAGE__",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tin-bot",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        { "name": "DISCORD_TOKEN", "value": "__DISCORD_TOKEN__" },
        { "name": "PROOF_ARCHIVE_CHANNEL_ID", "value": "__PROOF_ARCHIVE_CHANNEL_ID__" },
        { "name": "SYNC_API_BASE_URL", "value": "__SYNC_API_BASE_URL__" },
        { "name": "GOOGLE_PROJECT_ID", "value": "__GOOGLE_PROJECT_ID__" },
        { "name": "GOOGLE_CLIENT_EMAIL", "value": "__GOOGLE_CLIENT_EMAIL__" },
        { "name": "GOOGLE_SPREADSHEET_ID", "value": "__GOOGLE_SPREADSHEET_ID__" },
        { "name": "GOOGLE_PRIVATE_KEY", "value": "__GOOGLE_PRIVATE_KEY__" }
      ]
    }
  ]
}
